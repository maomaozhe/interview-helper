[Unit]
Description=Interview private Laya System One decision service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory="@SERVICE_DIR@"
EnvironmentFile="@SERVICE_DIR@/service.env"
Environment="PYTHONPATH=@SERVICE_DIR@/laya-src"
ExecStart="@PYTHON_BIN@" -u "@SERVICE_DIR@/laya_server.py"
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
