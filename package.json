{
  "name": "interview-intelligence-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": ">=22.19.0"},
  "workspaces": ["vendor/pi/packages/telemetry", "vendor/pi/packages/ai", "vendor/pi/packages/agent"],
  "scripts": {
    "build:pi": "node scripts/build-pi.mjs",
    "check": "node --check services/pi-agent/runtime.mjs && node --check services/pi-agent/server.mjs",
