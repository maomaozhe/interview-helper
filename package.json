    "start:agent": "node services/pi-agent/server.mjs"
  },
  "dependencies": {"@earendil-works/pi-agent-core": "1.0.2", "@earendil-works/pi-ai": "1.0.2", "typebox": "1.3.27"},
  "devDependencies": {"typescript": "7.0.2", "@types/node": "22.19.19"}
}
