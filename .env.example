DATABASE_URL=postgresql+psycopg://interview:localdev@localhost:5432/interview_intelligence
ELASTICSEARCH_URL=http://localhost:9200
MODEL_API_KEY=
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
EXTRACTION_MODEL=ark-code-latest
EMBEDDING_MODEL=doubao-embedding-vision
JUDGE_MODEL=ark-code-latest
RERANKER_MODEL=ark-code-latest
CORPUS_ROOT=./md
SNAPSHOT_ROOT=./data/snapshots
LOCAL_USER_ID=local
APP_SIGNING_KEY=replace-with-random-string
EMBEDDING_DIMENSION=1024
MAX_MODEL_CALLS=
MAX_MODEL_TOKENS=
MODEL_MIN_INTERVAL_SECONDS=2
MODEL_REQUEST_TIMEOUT_SECONDS=180
EXTRACTION_STREAM=true
EXTRACTION_PROMPT_VERSION=extract_question_v2
EXTRACTION_THINKING_MODE=auto
MODEL_LOCK_PATH=data/model-call.lock
API_ROOT_PATH=
API_BIND_PORT=8000
QUERY_ROUTER_ENABLED=true
PI_AGENT_ENABLED=true
PI_AGENT_URL=http://127.0.0.1:8787
INTERNAL_AGENT_TOKEN=replace-with-another-random-token
QUERY_MODEL=ark-code-latest
QUERY_PROMPT_VERSION=query_agent_v13
QUERY_DEADLINE_SECONDS=180
QUERY_MAX_MODEL_CALLS=4
QUERY_MAX_TOKENS=96000
QUERY_COMPACT_CONTEXT=true
QUERY_DYNAMIC_TOOLS=true
DEDUP_CANDIDATE_BACKEND=auto
DEDUP_ANN_MIN_SIZE=10000
DEDUP_VERIFY_EQUIVALENCE=false
TASK_FILTERS_ENABLED=true
# KNOWN permits provisional machine labels; production defaults to human verified.
TASK_ANNOTATION_POLICY=VERIFIED
JEV_DECISION_ENABLED=false
JEV_PROVIDER=typesafe
JEV_DECISION_MODE=shadow
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_CONFIDENCE_THRESHOLD=0.85
JEV_TIMEOUT_SECONDS=5
# Only a passing independent calibration artifact can authorize local Fast Path.
JEV_CALIBRATION_PATH=
